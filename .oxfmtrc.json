{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": false,
  "semi": false,
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "trailingComma": "none",
  "sortPackageJson": false,
  "ignorePatterns": [
    "third_party",
    "Dice",
    "wasm/include/lua",
    "wasm/include/QuickJS",
    "wasm/include/yaml-cpp",
    "wasm/include/simdutf"
  ]
}
